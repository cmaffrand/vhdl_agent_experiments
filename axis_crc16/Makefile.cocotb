# =============================================================================
# Makefile.cocotb – CocoTB simulation runner for axis_crc16 modules
#
# Usage:
#   make -f Makefile.cocotb                     # run all modules
#   make -f Makefile.cocotb sim-axis_crc16_insert  # run inserter only
#   make -f Makefile.cocotb sim-axis_crc16_check   # run checker only
#   make -f Makefile.cocotb clean               # remove artefacts
#
# Waveforms are written to:
#   sim/cocotb_build/<module>/<module>_cocotb_tb.{vcd,ghw}
# =============================================================================

SIM          ?= ghdl
TOPLEVEL_LANG = vhdl
COMPILE_ARGS  = --std=08
GHDL_ARGS     = --std=08

COCOTB_MAKEFILES := $(shell cocotb-config --makefiles)

# Source files compiled for every simulation target (dependency order)
CRC16_SRCS := \
	$(abspath ../crc16/src/crc16_pkg.vhd) \
	$(abspath ../crc16/src/crc16.vhd)

MODULE_SRCS := \
	$(abspath src/axis_crc16_insert.vhd) \
	$(abspath src/axis_crc16_check.vhd)

COMMON_SRCS := $(CRC16_SRCS) $(MODULE_SRCS)

MODULES := axis_crc16_insert axis_crc16_check

.PHONY: all clean $(MODULES:%=sim-%)

all: $(MODULES:%=sim-%)

# ---------------------------------------------------------------------------
# Per-module simulation rule
# ---------------------------------------------------------------------------
define MODULE_RULE
sim-$(1):
	@echo "=== CocoTB simulation: $(1) ==="
	@mkdir -p $(abspath sim/cocotb_build/$(1))
	+$(MAKE) \
		-f $(COCOTB_MAKEFILES)/Makefile.sim \
		SIM=$(SIM) \
		TOPLEVEL_LANG=$(TOPLEVEL_LANG) \
		VHDL_SOURCES="$(COMMON_SRCS) $(abspath tb/$(1)_cocotb_tb.vhd)" \
		COCOTB_TOPLEVEL=$(1)_cocotb_tb \
		COCOTB_TEST_MODULES=test_$(1) \
		COMPILE_ARGS="$(COMPILE_ARGS)" \
		GHDL_ARGS="$(GHDL_ARGS)" \
		SIM_BUILD="$(abspath sim/cocotb_build/$(1))" \
		SIM_ARGS="--wave=$(abspath sim/cocotb_build/$(1)/$(1)_cocotb_tb.ghw) --vcd=$(abspath sim/cocotb_build/$(1)/$(1)_cocotb_tb.vcd)" \
		PYTHONPATH="$(abspath tb):$(PYTHONPATH)"
endef

$(foreach mod,$(MODULES),$(eval $(call MODULE_RULE,$(mod))))

clean:
	rm -rf $(abspath sim/cocotb_build)
	$(MAKE) -f $(COCOTB_MAKEFILES)/Makefile.sim clean SIM_BUILD=/tmp/cocotb_clean_dummy 2>/dev/null || true
